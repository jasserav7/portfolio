---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  type?: "button" | "submit";
  download?: boolean;
  class?: string;
}

const { href, variant = "primary", type = "button", download, class: className } = Astro.props;

const base =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-medium transition-colors duration-150";

const variants = {
  primary: "bg-moon text-white hover:bg-moon/90",
  secondary: "border border-accent text-text hover:border-moon hover:text-accent-soft",
};
---

{
  href ? (
    <a href={href} download={download} class:list={[base, variants[variant], className]}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={[base, variants[variant], className]}>
      <slot />
    </button>
  )
}
