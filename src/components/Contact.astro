---
/**
 * Contact section: mailto button, copy-email button and social links.
 * Email button (mailto), a copy-email button enhanced by JS, and the
 * LinkedIn / GitHub links. The email is also shown as text so it is readable
 * without JavaScript.
 */
import SectionHeading from "./SectionHeading.astro";
import Button from "./Button.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import { getProfile } from "../data/profile";
import { ui, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = ui[lang];
const profile = getProfile(lang);

const secondaryButton =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-medium transition-colors duration-150 border border-accent text-text hover:border-moon hover:text-accent-soft";

const socialLinks = [
  { href: profile.linkedin, label: "LinkedIn", Icon: LinkedinIcon },
  { href: profile.github, label: "GitHub", Icon: GithubIcon },
];
---

<section
  id="contacto"
  aria-labelledby="contacto-titulo"
  data-reveal
  class="scroll-mt-24 py-20 md:py-28"
>
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <SectionHeading
      label={t.contact.label}
      title={t.contact.title}
      headingId="contacto-titulo"
    />
    <p class="mt-5 max-w-prose text-muted">
      {t.contact.text}
    </p>

    <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center">
      <Button href={`mailto:${profile.email}`} class="w-full sm:w-auto">{t.contact.writeEmail}</Button>
      <button
        type="button"
        data-copy-button
        data-copy-email={profile.email}
        data-copied-label={t.contact.copied}
        data-copied-status={t.contact.copiedStatus}
        data-error-status={t.contact.copyError}
        style="display:none"
        class:list={[secondaryButton, "w-full sm:w-auto"]}
      >
        <span data-copy-label>{t.contact.copyEmail}</span>
      </button>
    </div>

    <p data-copy-status aria-live="polite" class="mt-3 min-h-6 text-sm text-accent-soft"></p>

    <p class="mt-6 text-sm text-muted">
      {t.contact.emailLabel}<a
        href={`mailto:${profile.email}`}
        class="text-accent-soft transition-colors duration-150 hover:text-text">{profile.email}</a
      >
    </p>

    <ul class="mt-6 flex items-center gap-3">
      {
        socialLinks.map(({ href, label, Icon }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-11 items-center justify-center rounded-full border border-border text-muted transition-colors duration-150 hover:border-accent hover:text-text"
            >
              <Icon />
              <span class="sr-only">{label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import "../scripts/copy-email.ts";
</script>
