---
const year = new Date().getFullYear();

/*
 * Fase 1: el nombre, la ciudad y los enlaces viven aquí porque el plan pide
 * crear el Footer en esta fase. En la Fase 2 pasan a src/data/profile.ts.
 */
const socialLinks = [
  { href: "https://github.com/jasserav7", label: "GitHub" },
  { href: "https://www.linkedin.com/in/jasser-arrieta-784406322/", label: "LinkedIn" },
];
---

<footer class="border-t border-border">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-muted md:flex-row md:items-center md:justify-between md:px-6"
  >
    <p>© {year} Jasser Arrieta Villa · Barranquilla, Colombia</p>
    <ul class="flex gap-6">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors duration-150 hover:text-text"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
