---
import { getProfile } from "../data/profile";
import type { Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const profile = getProfile(lang);

const year = new Date().getFullYear();

const socialLinks = [
  { href: profile.github, label: "GitHub" },
  { href: profile.linkedin, label: "LinkedIn" },
];
---

<footer class="border-t border-border">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-muted md:flex-row md:items-center md:justify-between md:px-6"
  >
    <p>© {year} {profile.name} · {profile.location}</p>
    <ul class="flex gap-6">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors duration-150 hover:text-text"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
