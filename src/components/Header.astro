---
import { profile } from "../data/profile";

const navItems = [
  { href: "#inicio", label: "Inicio" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#stack", label: "Stack" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-border bg-bg/80 backdrop-blur-sm">
  <div class="mx-auto flex min-h-16 max-w-6xl flex-wrap items-center gap-y-2 px-4 md:px-6">
    <a href="#inicio" class="font-display text-lg font-semibold tracking-tight text-text">
      {profile.shortName}<span class="text-accent" aria-hidden="true">.</span>
    </a>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="menu-principal"
      class="ml-auto inline-flex size-11 items-center justify-center rounded-lg text-muted transition-colors duration-150 hover:text-text md:hidden"
    >
      <span class="sr-only">Menú</span>
      <svg
        aria-hidden="true"
        focusable="false"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav
      id="menu-principal"
      data-menu-panel
      aria-label="Navegación principal"
      class="hidden w-full md:ml-auto md:flex md:w-auto md:items-center"
    >
      <ul class="flex flex-col pb-3 md:flex-row md:items-center md:gap-6 md:pb-0">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="block px-2 py-3 text-muted transition-colors duration-150 hover:text-text md:px-0 md:py-2"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import "../scripts/mobile-menu.ts";
</script>
