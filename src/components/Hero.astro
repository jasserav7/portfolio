---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import MailIcon from "./icons/MailIcon.astro";
import { profile } from "../data/profile";
import portrait from "../assets/pfp.jpeg";

/* First phrase is rendered by the server so it survives without JavaScript. */
const [firstPhrase] = profile.typedPhrases;
---

<section id="inicio" aria-labelledby="inicio-titulo" class="relative scroll-mt-24 py-20 md:py-28">
  <div class="hero-ambient pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-4 md:px-6">
    <div class="flex flex-col gap-12 lg:grid lg:grid-cols-2 lg:items-center lg:gap-16">
      <div class="order-2 flex flex-col items-start">
        <h1 id="inicio-titulo" class="font-display text-h1 font-semibold text-muted">
          {profile.greeting} <span class="text-accent-soft">{profile.shortName}</span>
        </h1>

        <p
          class="mt-5 min-h-[2.75em] max-w-prose font-display text-xl leading-snug font-medium text-text sm:min-h-[1.4em] sm:text-2xl"
        >
          <span data-typing data-phrases={JSON.stringify(profile.typedPhrases)}>{firstPhrase}</span><span
            class="typing-cursor"
            data-typing-cursor
            aria-hidden="true"
            hidden></span>
        </p>

        <p class="mt-6 max-w-prose text-muted">{profile.heroParagraph}</p>

        <ul class="mt-8 flex items-center gap-3">
          <li>
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="inline-flex size-11 items-center justify-center rounded-full border border-border text-muted transition-colors duration-150 hover:border-accent hover:text-text"
            >
              <GithubIcon />
            </a>
          </li>
          <li>
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="inline-flex size-11 items-center justify-center rounded-full border border-border text-muted transition-colors duration-150 hover:border-accent hover:text-text"
            >
              <LinkedinIcon />
            </a>
          </li>
          <li>
            <a
              href={`mailto:${profile.email}`}
              aria-label="Correo electrónico"
              class="inline-flex size-11 items-center justify-center rounded-full border border-border text-muted transition-colors duration-150 hover:border-accent hover:text-text"
            >
              <MailIcon />
            </a>
          </li>
        </ul>

        <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center">
          <Button href="#proyectos" class="w-full sm:w-auto">Ver proyectos</Button>
          <Button href={profile.cvUrl} variant="secondary" download class="w-full sm:w-auto">
            Descargar CV (PDF)
          </Button>
        </div>
      </div>

      <div class="order-1 relative mx-auto aspect-[4/5] w-56 sm:w-64 lg:mx-0 lg:w-full lg:max-w-sm">
        <div class="moon" aria-hidden="true"></div>
        <Image
          src={portrait}
          alt={`Retrato de ${profile.name}`}
          widths={[256, 384, 512, 768]}
          sizes="(min-width: 1024px) 24rem, 16rem"
          class="relative size-full rounded-[50%] bg-surface-2 object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/typing.ts";
</script>

<style>
  /* Subtle ambient glow in a corner — docs/02-DISENO.md (Hero). */
  .hero-ambient {
    background-image: radial-gradient(60% 55% at 88% 0%, var(--color-ambient), transparent 70%);
  }

  /* Red moon behind the portrait — docs/02-DISENO.md (Hero). */
  .moon {
    position: absolute;
    top: -6%;
    right: -6%;
    width: 72%;
    aspect-ratio: 1;
    border-radius: 50%;
    background-image: linear-gradient(140deg, var(--color-moon), var(--color-moon-deep));
    box-shadow: 0 0 80px var(--color-glow);
  }

  .typing-cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.12em;
    background-color: var(--color-moon);
  }

  .typing-cursor[hidden] {
    display: none;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .typing-cursor {
      animation: cursor-blink 1s step-end infinite;
    }
  }
</style>
