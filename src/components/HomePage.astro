---
/**
 * Home page shared by the Spanish (/) and English (/en/) routes.
 */
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import Projects from "./Projects.astro";
import Skills from "./Skills.astro";
import Contact from "./Contact.astro";
import { homePath, ui, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = ui[lang];
const alternates = { es: homePath("es"), en: homePath("en") };
---

<Layout title={t.siteTitle} description={t.siteDescription} lang={lang} alternates={alternates}>
  <Hero lang={lang} />
  <About lang={lang} />
  <Projects lang={lang} />
  <Skills lang={lang} />
  <Contact lang={lang} />
</Layout>
