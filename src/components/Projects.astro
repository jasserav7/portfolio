---
/**
 * Projects section: the featured project first, then the rest in data order.
 * Featured project first, two columns on desktop.
 */
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
import { getProjects } from "../data/projects";
import { ui, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = ui[lang];
const projects = getProjects(lang);
---

<section
  id="proyectos"
  aria-labelledby="proyectos-titulo"
  data-reveal
  class="scroll-mt-24 py-20 md:py-28"
>
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <SectionHeading
      label={t.projects.label}
      title={t.projects.title}
      headingId="proyectos-titulo"
    />
    <p class="mt-5 max-w-prose text-muted">
      {t.projects.subtitle}
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </div>
</section>
