---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import SectionHeading from "../components/SectionHeading.astro";

const siteTitle = "Jasser Arrieta — Desarrollador Full-Stack";
const siteDescription =
  "Desarrollador de Software Full-Stack en Barranquilla, Colombia. Proyectos con Python, FastAPI, React y TypeScript.";

/* Fases 3 y 4: secciones todavía sin contenido. */
const sections = [
  { id: "proyectos", label: "Proyectos", title: "Lo que he construido" },
  { id: "stack", label: "Stack", title: "Con qué trabajo" },
  { id: "contacto", label: "Contacto", title: "¿Hablamos?" },
];
---

<Layout title={siteTitle} description={siteDescription}>
  <Hero />
  <About />
  {
    sections.map((section) => (
      <section
        id={section.id}
        aria-labelledby={`${section.id}-titulo`}
        class="scroll-mt-24 py-20 md:py-28"
      >
        <div class="mx-auto max-w-6xl px-4 md:px-6">
          <SectionHeading
            label={section.label}
            title={section.title}
            headingId={`${section.id}-titulo`}
          />
        </div>
      </section>
    ))
  }
</Layout>
